# ============================================================
# Lemma Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- PostgreSQL (only needed if using Docker Compose) ---
LEMMA_POSTGRES_DB=lemma
LEMMA_POSTGRES_USER=postgres
LEMMA_POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- Elasticsearch (only needed if using Docker Compose) ---
LEMMA_ELASTICSEARCH_URL=http://localhost:9200

# --- Redis & Celery ---
LEMMA_REDIS_URL=redis://localhost:6379/0
LEMMA_CELERY_ALWAYS_EAGER=True

# --- Ollama (Local LLM) ---
LEMMA_OLLAMA_URL=http://127.0.0.1:11434
LEMMA_OLLAMA_MODEL=lemma-model

# --- Gemini AI Detection (Optional) ---
# Get your key from: https://aistudio.google.com/apikey
# LEMMA_GEMINI_API_KEY=your_gemini_api_key_here

# --- Semantic Scholar (Optional — for online retrieval) ---
# LEMMA_SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# --- Firebase (Optional — Phase 4) ---
# LEMMA_FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
